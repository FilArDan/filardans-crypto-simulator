# Строка подключения к MongoDB (обязательно). Для своего сервера/VPS обычно:
# MONGODB_URI=mongodb://localhost:27017
# Если на MongoDB включена аутентификация:
# MONGODB_URI=mongodb://user:password@localhost:27017
MONGODB_URI=mongodb://localhost:27017

# Имя базы данных внутри MongoDB (необязательно, по умолчанию mothership_crypto)
MONGODB_DB_NAME=mothership_crypto

# Секрет для подписи сессионных кук (обязательно смени на проде на случайную строку)
SECRET=crypto-dev-secret-2025

# production — включает secure-куки (нужно для работы в iframe/Foundry)
NODE_ENV=development

# Порт HTTP-сервера (необязательно, по умолчанию 3000)
PORT=3000
