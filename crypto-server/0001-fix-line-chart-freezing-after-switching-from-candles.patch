From e3ce6be6e915ac5bbc3268107ee7ecad179daa89 Mon Sep 17 00:00:00 2001
From: Claude Assistant <assistant@local>
Date: Mon, 31 Aug 2026 15:31:56 +0000
Subject: [PATCH] fix: line chart freezing after switching from candles

Root cause: dedupAscending() shifted duplicate-second timestamps
forward when rebuilding the line series (setData), while
updateLiveSeries() sent the real, unshifted timestamp on every
subsequent tick (series.update()). Lightweight Charts requires
strictly non-decreasing time; once the shifted time in the series
got ahead of the next real tick, series.update() threw inside the
forEach in updateLiveSeries(), silently aborting all further chart
updates for every coin. Candle mode was unaffected because 30s
bucket aggregation absorbs same-second collisions without shifting
time.

Duplicate-second points happen routinely in normal play, since
addPricePoint() is called from every loadState() (after trades,
transfers, loans, etc.), not just the periodic market tick.

Fix: collapse same-second points into the last value instead of
shifting time forward, so setData() and update() always agree on
time.

Also fixed a leftover reference to the removed renderChart()
function in the theme-toggle handler (app.js), which threw a
ReferenceError on theme switch and left the chart not refreshing
theme colors.
---
 crypto-server/public/js/app.js   |  2 +-
 crypto-server/public/js/chart.js | 20 ++++++++++++++++----
 2 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/crypto-server/public/js/app.js b/crypto-server/public/js/app.js
index fa6d6ec..2da402a 100644
--- a/crypto-server/public/js/app.js
+++ b/crypto-server/public/js/app.js
@@ -555,7 +555,7 @@ socket.on('coinsUpdated', ({ coins }) => {
       dark = !dark;
       html.setAttribute('data-theme', dark ? 'dark' : 'light');
       btn.textContent = dark ? '☀️' : '🌙';
-      renderChart();
+      if (typeof createChartInstance === 'function') createChartInstance();
     });
   }
 })();
diff --git a/crypto-server/public/js/chart.js b/crypto-server/public/js/chart.js
index 4840dae..0348b78 100644
--- a/crypto-server/public/js/chart.js
+++ b/crypto-server/public/js/chart.js
@@ -170,14 +170,26 @@ function getUpDownColors() {
   return { up, dn };
 }
 
+// Схлопывает точки в одну секунду в одну (берём последнюю цену в секунде).
+// Важно: НЕ сдвигаем время вперёд искусственно (как раньше), иначе время в
+// setData() расходится с реальным временем, которое шлёт updateLiveSeries()
+// через series.update() — а Lightweight Charts требует строго неубывающее
+// время и кидает исключение, если live-апдейт приходит с временем меньше
+// уже отрисованного. Именно это "ронял" линейный график после переключения
+// с свечей на линию.
 function dedupAscending(points) {
   const out = [];
-  let lastTime = -Infinity;
   points.forEach(p => {
     const point = { ...p };
-    if (point.time <= lastTime) point.time = lastTime + 1;
-    out.push(point);
-    lastTime = point.time;
+    const last = out[out.length - 1];
+    if (last && point.time === last.time) {
+      out[out.length - 1] = point; // та же секунда — просто обновляем значение
+    } else if (last && point.time < last.time) {
+      // время не может идти назад (ts монотонны), но на всякий случай не ломаем порядок
+      return;
+    } else {
+      out.push(point);
+    }
   });
   return out;
 }
