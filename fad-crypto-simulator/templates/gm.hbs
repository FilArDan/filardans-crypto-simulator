<div class="cs-panel">

  <!-- ШАПКА -->
  <div class="cs-header">
    <div class="cs-header-left">
      <span class="cs-status {{#if paused}}paused{{else}}running{{/if}}">
        {{#if paused}}⏸ Пауза{{else}}▶ Идёт{{/if}}
      </span>
      {{! LIVE — bank info обновляется через onTick() по ID }}
      <span class="cs-bank-info">
        🏦 Банк: <span id="gm-bank-cash">{{bankCash}}</span>
        &nbsp;|&nbsp;
        Ставка: <span id="gm-bank-rate">{{bankRate}}</span>/тик
      </span>
    </div>
    <div class="cs-header-right">
      <button data-action="toggle-pause" class="cs-btn {{#if paused}}cs-btn-green{{else}}cs-btn-warn{{/if}}">
        {{#if paused}}▶ Запустить{{else}}⏸ Пауза{{/if}}
      </button>
      <button data-action="reset-market" class="cs-btn cs-btn-ghost">↺ Сброс цен</button>
    </div>
  </div>

  <!-- ВКЛАДКИ — добавлена вкладка Графики -->
  <nav class="cs-tabs">
    <a class="item" data-tab="market"     >📈 Рынок</a>
    <a class="item" data-tab="chart"      >📊 Графики</a>  {{! NEW }}
    <a class="item" data-tab="players"    >👥 Игроки</a>
    <a class="item" data-tab="bots"       >🤖 Боты</a>
    <a class="item" data-tab="leaderboard">🏆 Таблица</a>
  </nav>

  <div class="cs-body">

    <!-- ====== РЫНОК ====== -->
    <div class="tab" data-tab="market">
      <div class="cs-coin-grid">
        {{#each coinList}}
        <div class="cs-coin-card">
          <div class="cs-coin-head">
            <span class="cs-dot" style="color:{{col}}">●</span>
            <strong>{{name}} ({{sym}})</strong>
            {{! LIVE — цена обновляется через DOM без перерендера }}
            <span class="cs-price" data-live-price="{{sym}}">{{price}}</span>
          </div>

          <div class="cs-shock-row">
            <button class="cs-shock up"   data-action="shock" data-sym="{{sym}}" data-pct="0.30" >▲+30%</button>
            <button class="cs-shock up"   data-action="shock" data-sym="{{sym}}" data-pct="0.10" >▲+10%</button>
            <button class="cs-shock down" data-action="shock" data-sym="{{sym}}" data-pct="-0.10">▼−10%</button>
            <button class="cs-shock down" data-action="shock" data-sym="{{sym}}" data-pct="-0.30">▼−30%</button>
          </div>

          <div class="cs-slider-row">
            <div class="cs-slider-label">
              <span>Тренд</span>
              <span class="cs-slider-val">{{drift}}%</span>
            </div>
            <input type="range" data-action="drift" data-sym="{{sym}}"
                   min="-100" max="100" value="{{drift}}"/>
            <div class="cs-slider-hints"><span>← Падение</span><span>Рост →</span></div>
          </div>

          <div class="cs-slider-row">
            <div class="cs-slider-label">
              <span>Волатильность</span>
              <span class="cs-slider-val">{{vol}}%</span>
            </div>
            <input type="range" data-action="vol" data-sym="{{sym}}"
                   min="0" max="30" value="{{vol}}"/>
            <div class="cs-slider-hints"><span>← Стабильно</span><span>Хаос →</span></div>
          </div>

          <div class="cs-input-row">
            <input type="number" data-price-input="{{sym}}" placeholder="Задать цену" min="0.01" step="0.01"/>
            <button data-action="set-price" data-sym="{{sym}}" class="cs-btn cs-btn-sm">Задать</button>
          </div>

          <div class="cs-supply">Supply: {{supply}}</div>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- ====== ГРАФИКИ (NEW) ====== -->
    <div class="tab" data-tab="chart">
      <div class="cs-chart-panel">
        <div class="cs-chart-coins" id="gm-ctabs"></div>
        <div class="cs-chart-ranges">
          <button class="cs-rbtn active" data-range="40" >40</button>
          <button class="cs-rbtn"        data-range="100">100</button>
          <button class="cs-rbtn"        data-range="200">200</button>
          <button class="cs-rbtn"        data-range="0"  >Всё</button>
        </div>
        <div class="cs-chart-wrap-lg">
          <canvas id="gm-chart"></canvas>
        </div>
        <div class="cs-chart-info" id="gm-chart-info"></div>
      </div>
    </div>

    <!-- ====== ИГРОКИ ====== -->
    <div class="tab" data-tab="players">

      <div class="cs-transfer-box">
        <strong>💸 Перевод между игроками</strong>
        <div class="cs-transfer-row">
          <select data-transfer="from">
            {{#each userList}}<option value="{{id}}">{{name}}</option>{{/each}}
          </select>
          <span>→</span>
          <select data-transfer="to">
            {{#each userList}}<option value="{{id}}">{{name}}</option>{{/each}}
          </select>
          <input type="number" data-transfer="amount" placeholder="Сумма" min="0" step="100"/>
          <button data-action="transfer" class="cs-btn cs-btn-sm">Перевести</button>
        </div>
      </div>

      {{#each userList}}
      <div class="cs-player-card {{#if frozen}}cs-frozen{{/if}}">
        <div class="cs-player-head">
          <span class="cs-player-dot" style="background:{{color}}"></span>
          <strong>{{name}}</strong>
          {{#if online}}<span class="cs-online">●</span>{{else}}<span class="cs-offline">○</span>{{/if}}
          {{#if frozen}}<span class="cs-badge danger">🔒 Заморожен</span>{{/if}}
          <div class="cs-player-totals">
            {{! LIVE — обновляются через onTick() по ID }}
            Баланс: <b id="gm-cash-{{id}}">{{cashFmt}}</b>
            &nbsp;|&nbsp;
            Портфель: <b id="gm-port-{{id}}">{{portFmt}}</b>
            {{#if loan}}&nbsp;|&nbsp; Долг: <span class="cs-danger">{{loanFmt}}</span>{{/if}}
          </div>
        </div>

        <div class="cs-input-row" style="margin-top:8px;">
          <input type="number" data-cash-input="{{id}}" placeholder="Новый баланс" min="0" step="100"/>
          <button data-action="set-cash" data-uid="{{id}}" class="cs-btn cs-btn-sm">Задать</button>
          <button data-action="toggle-freeze" data-uid="{{id}}"
                  class="cs-btn cs-btn-sm {{#if frozen}}cs-btn-green{{else}}cs-btn-warn{{/if}}">
            {{#if frozen}}🔓 Разморозить{{else}}🔒 Заморозить{{/if}}
          </button>
        </div>

        <div class="cs-holdings-grid">
          {{#each held}}
          <div class="cs-holding-row {{#if sanctioned}}cs-sanctioned{{/if}}">
            <span style="color:{{col}}">●</span>
            <span>{{sym}}</span>
            <span>{{amt}}</span>
            <span class="cs-muted">{{val}}</span>
            <button data-action="toggle-sanction" data-uid="{{../id}}" data-sym="{{sym}}"
                    class="cs-btn cs-btn-xs {{#if sanctioned}}cs-btn-green{{else}}cs-btn-warn{{/if}}"
                    title="{{#if sanctioned}}Снять санкцию{{else}}Ввести санкцию{{/if}}">
              {{#if sanctioned}}✅{{else}}🚫{{/if}}
            </button>
            <button data-action="confiscate" data-uid="{{../id}}" data-sym="{{sym}}"
                    class="cs-btn cs-btn-xs cs-btn-danger" title="Конфисковать">⚡</button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>

    <!-- ====== БОТЫ ====== -->
    <div class="tab" data-tab="bots">
      <div class="cs-bot-grid">
        {{#each bots}}
        <div class="cs-bot-card">
          <div class="cs-bot-head">
            {{#if (eq type "bull")}}🐂{{else if (eq type "fox")}}🦊{{else}}🐊{{/if}}
            <strong>{{name}}</strong>
            <span class="cs-muted">{{type}}</span>
          </div>
          <div class="cs-muted" style="font-size:12px;margin-bottom:8px;">Баланс: {{cash}}</div>
          <div class="cs-input-row">
            <input type="number" data-bot-cash-input="{{@index}}" placeholder="Новый бюджет" min="0"/>
            <button data-action="set-bot-cash" data-idx="{{@index}}" class="cs-btn cs-btn-sm">Задать</button>
          </div>
          <button data-action="remove-bot" data-idx="{{@index}}"
                  class="cs-btn cs-btn-danger" style="width:100%;margin-top:8px;">🗑 Удалить</button>
        </div>
        {{/each}}

        <div class="cs-bot-card cs-bot-add">
          <div class="cs-bot-head">➕ <strong>Новый бот</strong></div>
          <label>Имя</label>
          <input type="text" data-bot-input="name" placeholder="Имя бота"/>
          <label>Тип</label>
          <select data-bot-input="type">
            <option value="bull">🐂 Агрессор</option>
            <option value="fox">🦊 Осторожный</option>
            <option value="croc">🐊 Накопитель</option>
          </select>
          <label>Стартовый бюджет ($)</label>
          <input type="number" data-bot-input="cash" value="10000" min="100"/>
          <button data-action="add-bot" class="cs-btn cs-btn-green" style="width:100%;margin-top:8px;">
            ➕ Добавить
          </button>
        </div>
      </div>
    </div>

    <!-- ====== ТАБЛИЦА ЛИДЕРОВ ====== -->
    <div class="tab" data-tab="leaderboard">
      <table class="cs-table">
        <thead>
          <tr><th>#</th><th>Участник</th><th>Капитал</th></tr>
        </thead>
        <tbody id="gm-leaderboard">
          {{#each leaderboard}}
          <tr class="{{#if isPlayer}}cs-tr-player{{/if}}">
            <td>{{add @index 1}}</td>
            <td>{{name}}</td>
            {{! LIVE — обновляется через onTick() }}
            <td class="cs-mono" id="gm-lb-{{@index}}">{{total}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  </div><!-- .cs-body -->
</div>