{{! Скелет рендерится один раз, далее DOM обновляется напрямую из JS }}
<div class="csp-wrap">

  <!-- СТАТЫ -->
  <div class="csp-stats">
    <div class="csp-stat"><div class="csp-lbl">Баланс USD</div><div class="csp-val" id="csp-cash">–</div></div>
    <div class="csp-stat"><div class="csp-lbl">Монеты</div><div class="csp-val" id="csp-port">–</div></div>
    <div class="csp-stat"><div class="csp-lbl">Весь капитал</div><div class="csp-val" id="csp-total">–</div></div>
    <div class="csp-stat"><div class="csp-lbl">Прибыль / убыток</div><div class="csp-val" id="csp-pnl">–</div></div>
  </div>

  <!-- ЗАМОРОЗКА -->
  <div class="csp-frozen-bar" id="csp-frozen-bar" style="display:none">
    🔒 Счёт заморожен. Торговля недоступна.
  </div>

  <!-- ДОЛГ -->
  <div class="csp-loan-bar" id="csp-loan-bar" style="display:none">
    ⚠️ Долг: <b id="csp-loan-val">$0</b> · ставка <b id="csp-loan-rate">—</b>/тик
  </div>

  <!-- СДЕЛКА -->
  <div class="csp-card">
    <h2>💱 Сделка</h2>
    <div class="csp-tr">
      <div class="csp-fld">
        <label>Монета</label>
        <select id="csp-coin">
          {{#each coinList}}
          <option value="{{sym}}">{{name}} ({{sym}})</option>
          {{/each}}
        </select>
      </div>
      <div class="csp-fld">
        <label>Количество</label>
        <input id="csp-amt" type="number" min="0.0001" step="0.0001" placeholder="0.0000"/>
      </div>
    </div>
    <div class="csp-bts">
      <button id="csp-buy"  class="csp-btn csp-buy">📈 Купить</button>
      <button id="csp-sell" class="csp-btn csp-sell">📉 Продать</button>
      <button id="csp-sell-all" class="csp-btn csp-ghost">💨 Всё</button>
    </div>
    <div class="csp-msg" id="csp-msg">Выбери монету и нажми «Купить».</div>
  </div>

  <!-- МОНЕТЫ + ИСТОРИЯ -->
  <div class="csp-g2">
    <div class="csp-card">
      <h2>💼 Мои монеты</h2>
      <div class="csp-ilist" id="csp-holdings"></div>
    </div>
    <div class="csp-card">
      <h2>📋 История</h2>
      <div class="csp-ilist" id="csp-history"></div>
    </div>
  </div>

</div>
