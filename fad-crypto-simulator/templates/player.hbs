<div class="csp-wrap">

  <!-- СТАТЫ — обновляются через DOM по ID -->
  <div class="csp-stats">
    <div class="csp-stat">
      <div class="csp-lbl">Баланс USD</div>
      <div class="csp-val" id="csp-cash">–</div>
    </div>
    <div class="csp-stat">
      <div class="csp-lbl">Монеты</div>
      <div class="csp-val" id="csp-port">–</div>
    </div>
    <div class="csp-stat">
      <div class="csp-lbl">Весь капитал</div>
      <div class="csp-val" id="csp-total">–</div>
    </div>
    <div class="csp-stat">
      <div class="csp-lbl">Прибыль / убыток</div>
      <div class="csp-val" id="csp-pnl">–</div>
    </div>
  </div>

  <div id="csp-frozen-bar" class="csp-frozen-bar" style="display:none">
    🔒 Счёт заморожен. Торговля недоступна.
  </div>
  <div id="csp-loan-bar" class="csp-loan-bar" style="display:none">
    ⚠️ Долг: <b id="csp-loan-val">$0</b>
  </div>

  <!-- ТАБЫ -->
  <div class="csp-tabs">
    <button class="csp-tab active" data-tab="trade">💱 Сделка</button>
    <button class="csp-tab"        data-tab="chart">📈 График</button>
    <button class="csp-tab"        data-tab="port" >💼 Монеты</button>
    <button class="csp-tab"        data-tab="hist" >📋 История</button>
  </div>

  <!-- ВКЛАДКА: СДЕЛКА -->
  <div id="csp-tab-trade" class="csp-pane active">
    <div class="csp-card">
      <div class="csp-row2">
        <div class="csp-fld">
          <label>Монета</label>
          <select id="csp-coin">
            {{#each coinList}}
            <option value="{{sym}}">{{name}} ({{sym}})</option>
            {{/each}}
          </select>
        </div>
        <div class="csp-fld">
          <label>Количество</label>
          <input id="csp-amt" type="number" min="0.0001" step="0.0001" placeholder="0.0000"/>
        </div>
      </div>
      <div class="csp-bts3">
        <button id="csp-buy"      class="csp-btn csp-buy" >📈 Купить</button>
        <button id="csp-sell"     class="csp-btn csp-sell">📉 Продать</button>
        <button id="csp-sell-all" class="csp-btn csp-ghost">💨 Всё</button>
      </div>
      <div class="csp-msg" id="csp-msg">Выбери монету и нажми «Купить».</div>
      <ul class="csp-tips">
        <li>Начальный баланс: <b>10 000 USD</b></li>
        <li>Комиссия: <b>1%</b> с каждой сделки</li>
      </ul>
    </div>
  </div>

  <!-- ВКЛАДКА: ГРАФИК -->
  <div id="csp-tab-chart" class="csp-pane">
    <div class="csp-card">
      <div class="csp-chart-top" id="csp-ctabs"></div>
      <div class="csp-range-row">
        <button class="csp-rbtn active" data-range="40" >40</button>
        <button class="csp-rbtn"        data-range="100">100</button>
        <button class="csp-rbtn"        data-range="200">200</button>
        <button class="csp-rbtn"        data-range="0"  >Всё</button>
      </div>
      <div class="csp-chart-wrap">
        <canvas id="csp-chart"></canvas>
      </div>
      <div class="csp-chart-info" id="csp-chart-info"></div>
    </div>
  </div>

  <!-- ВКЛАДКА: МОНЕТЫ / ПОРТФЕЛЬ -->
  <div id="csp-tab-port" class="csp-pane">
    <div class="csp-card">
      <div class="csp-ilist" id="csp-holdings"></div>
    </div>
  </div>

  <!-- ВКЛАДКА: ИСТОРИЯ -->
  <div id="csp-tab-hist" class="csp-pane">
    <div class="csp-card">
      <div class="csp-ilist" id="csp-history"></div>
    </div>
  </div>

</div>